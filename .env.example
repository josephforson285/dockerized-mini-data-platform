# cp .env.example .env && make secrets

# Ports — avoid host 5432/3306 and flight-price lab 5433/3307/8080
POSTGRES_PORT=5435
AIRFLOW_PORT=8082
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
METABASE_PORT=3001

# Postgres — one server, three DBs
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=analytics
AIRFLOW_DB=airflow
METABASE_DB=metabase

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=raw
MINIO_REGION=us-east-1

# Airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_UID=50000

# Metabase — quote values with spaces
METABASE_ADMIN_EMAIL=joseph.forson@aims.ac.rw
METABASE_ADMIN_PASSWORD=changeme
METABASE_SITE_NAME="Mini Data Platform"
